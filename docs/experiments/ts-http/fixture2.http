@host = example.com

# @name login
POST https://{{host}}/login
Content-Type: application/json
Authorization: Bearer {{token}}
X-Trace: abc

{
  "user": "a",
  "tags": ["x", "y"]
}

> {%
  client.log("hi");
%}

