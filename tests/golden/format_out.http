# format fixture: deliberately messy spacing
@host    = example.com
@version := v2
@note    = see below

< {%
if (!request.headers.has('X-Trace')) {
request.headers.set('X-Trace','fixture')
}
%}

### list users
GET https://{{host}}/api/users?page=1&limit=10
accept: application/json
Content-Type: application/json

{
  "a": 1,
  "z": [
    1,
    2
  ],
  "big": 1234567890123456789,
  "f": 1.0
}

### create user
// create one user, keep this comment where it is
POST https://{{host}}/api/users HTTP/1.1
Content-Type: application/json
X-Trace: abc

{
  "name": "x",
  "tags": [
    "a",
    "b"
  ]
}

> {%
const body = response.body;
if (body) { console.log(body) }
%}

### form post
POST https://{{host}}/api/form
Content-Type: application/x-www-form-urlencoded

a=1
&b=2
&c=3

?? status == 200
